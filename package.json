{
  "name": "little-moment-desktop",
  "version": "1.0.0",
  "description": "山间小憩：离线番茄钟、今日计划与专注日历",
  "author": "Xiaoyu",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --win --x64 --dir --publish never"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.xiaoyu.littlemoment",
    "productName": "山间小憩",
    "copyright": "山间小憩 · 个人专注工具",
    "asar": true,
    "directories": { "output": "release", "buildResources": "assets" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "win": {
      "icon": "assets/app.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "LittleMoment-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "山间小憩",
      "installerIcon": "assets/app.ico",
      "uninstallerIcon": "assets/app.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "installerLanguages": ["zh_CN"],
      "language": "2052"
    }
  }
}
